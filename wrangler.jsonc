{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bogopang",
  "main": "worker.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ALERT_STORE",
        "class_name": "ProductAlertStore"
      }
    ]
  },
  "exports": {
    "ProductAlertStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
